@model Movie_Catalog.Data.Models.Rating
@{
    ViewData["Title"] = "Rating Details";
}

<h1>Rating Details</h1>

<div class="mb-3">
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Movie</dt>
        <dd class="col-sm-10">@Model.Movie?.Title</dd>

        <dt class="col-sm-2">Rating</dt>
        <dd class="col-sm-10">@Model.RatingValue</dd>
    </dl>
</div>

<a asp-action="Index" class="btn btn-secondary">Back to Ratings</a>