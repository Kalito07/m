@model Movie_Catalog.Data.Models.Movie

@{
    ViewData["Title"] = "Add Rating";
}

<h2>Add Rating for @Model.Title</h2>

<form asp-action="AddRating" method="post">
    <input type="hidden" name="movieId" value="@Model.Id" />
    <div class="form-group mb-3">
        <label for="ratingValue">Rating (1 - 10)</label>
        <input type="number" id="ratingValue" name="ratingValue" class="form-control" min="1" max="10" step="0.1" required />
    </div>
    <button type="submit" class="btn btn-primary">Submit Rating</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>