@model IEnumerable<Movie_Catalog.Data.Models.Rating>

@{
    ViewData["Title"] = "Ratings";
}

<h1>All Ratings</h1>

<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Movie Title</th>
        <th>Rating Value</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var rating in Model)
    {
        <tr>
            <td>@rating.Id</td>
            <td>@rating.Movie?.Title</td>
            <td>@rating.RatingValue</td>
            <td>
                <a asp-action="Details" asp-route-id="@rating.Id">Details</a> |
                <form asp-action="Delete" asp-route-id="@rating.Id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<h3>Add Rating</h3>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="movieId">Movie ID</label>
        <input type="number" id="movieId" class="form-control" name="movieId" required />
    </div>
    <div class="form-group">
        <label for="ratingValue">Rating Value</label>
        <input type="number" step="0.1" id="ratingValue" class="form-control" name="ratingValue" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Add</button>
</form>
