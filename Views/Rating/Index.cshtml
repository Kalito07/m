@model IEnumerable<Movie_Catalog.Data.Models.Rating>

@{
    ViewData["Title"] = "All Ratings";
}

<h2>All Ratings</h2>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>Movie</th>
        <th>Rating</th>
        <th>Date Rated</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var rating in Model)
    {
        <tr>
            <td>@rating.Id</td>
            <td>@rating.Movie?.Title</td>
            <td>@rating.RatingValue</td>
            <td>
                <a asp-action="Details" asp-route-id="@rating.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@rating.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
