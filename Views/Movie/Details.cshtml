@model Movie_Catalog.Data.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<h2>@Model.Title</h2>

<div>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Release Year:</strong> @Model.ReleaseYear</p>
    <p><strong>Genre:</strong> @Model.Genre?.Name</p>
    <p><strong>Director:</strong> @Model.Director?.Name</p>
    <p><strong>Rating:</strong> @Model.Rating</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="All" class="btn btn-secondary">Back to List</a>