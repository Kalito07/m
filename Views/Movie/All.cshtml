@model ICollection<Movie_Catalog.Data.Models.Movie>

@{
    ViewData["Title"] = "Всички филми";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        h2 {
            font-weight: 600;
            color: #2c3e50;
        }

        .table th,
        .table td {
            vertical-align: middle;
        }

        .btn {
            transition: 0.3s ease-in-out;
        }

        .btn:hover {
            transform: scale(1.05);
        }

        .table-hover tbody tr:hover {
            background-color: #f1f3f5;
        }

        .btn-outline-info {
            color: #0dcaf0;
            border-color: #0dcaf0;
        }

        .btn-outline-info:hover {
            background-color: #0dcaf0;
            color: white;
        }
    </style>
</head>
<body>

    <div class="container mt-5">
        <h2 class="mb-4 text-center">🎬 Всички филми</h2>

        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>🎞️ Заглавие</th>
                        <th>🎭 Жанр</th>
                        <th>🎬 Режисьор</th>
                        <th>📅 Година</th>
                        <th>⭐ Оценка</th>
                        <th>⚙️ Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movie in Model)
                    {
                        <tr>
                            <td>@movie.Title</td>
                            <td>@movie.Genre?.Name</td>
                            <td>@movie.Director?.Name</td>
                            <td>@movie.ReleaseYear</td>
                            <td>@movie.Rating</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-info btn-sm me-1">🔍 Детайли</a>
                                <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-outline-warning btn-sm me-1">✏️ Редактирай</a>
                                <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-outline-danger btn-sm">🗑️ Изтрий</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-end mt-4">
            <a asp-action="Create" class="btn btn-success btn-lg">➕ Добави нов филм</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
