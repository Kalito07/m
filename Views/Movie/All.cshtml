@model ICollection<Movie_Catalog.Data.Models.Movie>

@{
    ViewData["Title"] = "All Movies";
}

<h2>All Movies</h2>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Title</th>
        <th>Genre</th>
        <th>Director</th>
        <th>Release Year</th>
        <th>Rating</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Genre?.Name</td>
            <td>@movie.Director?.Name</td>
            <td>@movie.ReleaseYear</td>
            <td>@movie.Rating</td>
            <td>
                <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Add New Movie</a>